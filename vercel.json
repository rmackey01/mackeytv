{
  "buildCommand": "sh store/build.sh",
  "outputDirectory": "web",
  "installCommand": "cd store && npm ci --no-audit --no-fund",
  "framework": null,
  "redirects": [
    {
      "source": "/apk",
      "destination": "https://github.com/rmackey01/mackeytv/releases/latest/download/mackeytv.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/version.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}